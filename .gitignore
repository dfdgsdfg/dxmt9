# meson build directories — wildcard catches every variant
# (build/, build-win32-x64/, build-x86_64-builtin/, build-win-test/, …).
build/
build-*/
builddir/
meson-logs/
meson-private/
compile_commands.json
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.lib
*.pdb
.DS_Store
.idea/
.vscode/
states/
.cache/
.venv/
tmp
traces/
experiments/output/*
!experiments/output/.gitkeep
# Runtime spec — see specs/experiments/runtime/.
experiments/apps_3rd/
experiments/prefixs/
experiments/wine/*
!experiments/wine/manifest.toml
!experiments/wine/README.md
experiments/apps/**/*.trace.txt
*.log
**/__pycache__
specs/**/plan.md
*.plan.md
.codex
.claude
.gemini
