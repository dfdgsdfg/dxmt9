option(
  'build_tests',
  type: 'boolean',
  value: true,
  description: 'Build the bootstrap smoke test.',
)

option(
  'wine_build_path',
  type: 'string',
  value: '',
  description: 'Path to a Wine build tree providing winebuild and builtin import libraries.',
)

option(
  'wine_install_path',
  type: 'string',
  value: '',
  description: 'Path to a Wine install tree providing winebuild/runtime libs for builtin modules.',
)

option(
  'wine_builtin_dll',
  type: 'boolean',
  value: true,
  description: 'Postprocess the PE d3d9.dll and winemetal.dll bridge pair as Wine builtin modules.',
)

option(
  'dxmt9_bridge_perf_counters',
  type: 'boolean',
  value: true,
  description: 'Compile bridge dispatch with perf-counter instrumentation. Disable for release-tuned builds.',
)
