option(
  'build_tests',
  type: 'boolean',
  value: true,
  description: 'Build the bootstrap smoke test.',
)

option(
  'wine_build_path',
  type: 'string',
  value: '',
  description: 'Path to a Wine build tree providing winebuild and builtin import libraries.',
)

option(
  'wine_install_path',
  type: 'string',
