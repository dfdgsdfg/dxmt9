# Schema example showing the per-entry `requires_patch` / `patch_status`
# fields added to experiments/wine/manifest.toml when this spec lands.
# Reference document — not a live manifest.
#
# Spec: specs/winemetal/{requirements,design}.md §5.
#
# Each [[wine]] entry uses the existing schema from
# specs/experiments/assets/wine-manifest.schema.toml plus two
# optional booleans/enums:
#
#   requires_patch  — does this Wine root need the dxmt9 macdrv
#                     symbol-expose patch applied for the bridge to
#                     work? Defaults to false (back-compat).
#   patch_status    — operator's assertion of patch state.
#                     One of: "applied" / "unpatched" / "unknown".
#                     Defaults to "unknown".
#
# Resolution behaviour at run time (R-WMB-5.3):
#   requires_patch=true  + patch_status="unpatched" → hard error before launch.
#   requires_patch=true  + patch_status="unknown"   → warn; let runtime probe decide.
#   requires_patch=true  + patch_status="applied"   → silent; trust operator.
#   requires_patch=false (any patch_status)         → silent; bridge probe still gates runtime.

manifest_version = 1

# ─── Stock Heroic / Gcenx Wine-11.7. Cannot serve dxmt9. ─────────────────
# Listed only so the harness can reject runs that point at it. The same
# pattern applies to every Heroic-redistributed Gcenx release we have
# audited as of 2026-05-11 (Wine-11.0_1, 11.6_1, 11.7, 11.7-DXMT,
# Wine-Crossover-23.7.1-1) — all ship a stripped winemac.so.
[[wine]]
id             = "heroic-11.7"
source         = "heroic"
variant        = "vanilla"
version        = "11.7"
path           = "$HOME/Library/Application Support/heroic/tools/wine/Wine-11.7/Contents/Resources/wine"
requires_patch = true
patch_status   = "unpatched"
notes          = "Wine 11.7 ships with macdrv visibility-default stripped on the Metal-bridge symbols; will not attach a Metal layer. The runtime probe (R-WMB-7) refuses to launch."

# ─── Heroic Wine-11.7-DXMT bundle. Same winemac.so as vanilla 11.7. ──────
[[wine]]
id             = "heroic-11.7-dxmt"
source         = "heroic"
variant        = "dxmt"
version        = "11.7"
path           = "$HOME/Library/Application Support/heroic/tools/wine/Wine-11.7-DXMT/Contents/Resources/wine"
requires_patch = true
patch_status   = "unpatched"
notes          = "The '-DXMT' suffix bundles pre-built dxmt D3D11 DLLs; winemac.so is md5-identical to the vanilla 11.7 build (67afe1eb6fab5b958f47a6d58f4306b8). dxmt9 cannot run on this root."

# ─── Path A: Sikarugir-Engines pre-built Wine (recommended default). ─────
# Installed via scripts/wine/install_wine.py --engine sikarugir-cx-24.0.7.
# The script extracts wswine.bundle into experiments/wine/<id>/, drops the
# Sikarugir Wrapper Template's Frameworks/*.dylib next to it, and wraps
# bin/wine + bin/wineserver with DYLD_FALLBACK_LIBRARY_PATH shims.
[[wine]]
id             = "sikarugir-cx-24.0.7"
source         = "sikarugir"
variant        = "patched"
version        = "wine-9.0 / SikarugirCX 24.0.7 r6"
path           = "$REPO_ROOT/experiments/wine/sikarugir-cx-24.0.7"
requires_patch = true
patch_status   = "applied"
notes          = "Sikarugir-App/Engines pre-built CrossOver-derived Wine. _macdrv_functions exposed; wow64 compatible with dxmt9's MemoryWineImageInfo lookups. Verified SFIV end-to-end 2026-05-11."

# ─── Path A alternative: Sikarugir's own Wine 10.0 fork. ──────────────────
[[wine]]
id             = "sikarugir-10.0"
source         = "sikarugir"
variant        = "patched"
version        = "wine-10.0 / Sikarugir 10.0 r6"
path           = "$REPO_ROOT/experiments/wine/sikarugir-10.0"
requires_patch = true
patch_status   = "applied"
notes          = "Alternate Sikarugir Wine (non-CrossOver lineage). Same install_wine.py recipe, different engine tag."

# ─── Path B: Self-built Wine with dxmt9 patch applied (R-WMB-10.B). ──────
[[wine]]
id             = "wine-source-built-11.7"
source         = "manual"
variant        = "vanilla"
version        = "11.7"
path           = "$REPO_ROOT/experiments/wine/wine-source-built-11.7/Contents/Resources/wine"
requires_patch = true
patch_status   = "applied"
notes          = "Operator-built per wine/patches/README.md from WineHQ / CodeWeavers source with wine/patches/winemac-expose-symbols-11.7.patch applied."

# ─── Documented-as-broken: CodeWeavers CrossOver product. ────────────────
# Listed for users who already own CrossOver. Audit on 2026-05-11
# (specs/winemetal/requirements.md §6.2 crossover-26 row) confirmed three
# independent blockers; no dxmt9-side code change unblocks all three.
[[wine]]
id             = "crossover-26"
source         = "crossover"
variant        = "patched"
version        = "wine-11.0-8709 / CrossOver 26"
path           = "$HOME/Applications/CrossOver.app/Contents/SharedSupport/CrossOver"
requires_patch = true
patch_status   = "unsupported"
notes          = "Four blockers: (1) Perl bin/wine needs a bottle context (bypassable via cxbottle CLI but does not fix the next three); (2) wow64 missing MemoryWineLoadUnixLibByName (class 1002) — bottle context does NOT bypass; (3) ntdll.so hardcodes /opt/cxoffice/lib/wine and WINEDLLDIR0/WINEDLLPATH overrides don't take effect; (4) CrossOver.app/lib/wine is SIP/codesign-protected — winemetal.so cannot be staged. Use Sikarugir-Engines instead."
