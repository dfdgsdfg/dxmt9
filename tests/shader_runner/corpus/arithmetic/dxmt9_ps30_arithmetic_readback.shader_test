[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
draw quad
expect-source pixel contains "r[0] = (cFloat[0] * cFloat[1] + cFloat[2]);"
expect-source pixel contains "float4(dot((cFloat[0]).xyz, (cFloat[1]).xyz))"
expect-source pixel contains "float4(dot(cFloat[0], cFloat[3]))"
probe (32, 32) rgba(0.2, 0.45, 0.19, 1.0) 2
