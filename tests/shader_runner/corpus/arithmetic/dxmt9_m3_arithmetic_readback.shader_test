[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
draw quad
expect-source pixel contains "fract(cFloat[2])"
expect-source pixel contains "mix(cFloat[2], cFloat[1], cFloat[0])"
expect-source pixel contains "dot((cFloat[3]).xy, (cFloat[1]).xy) + (cFloat[0]).x"
probe (32, 32) rgba(0.375, 0.5, 0.75, 1.0) 1
