[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
draw quad
expect-source pixel contains "select(cFloat[2], cFloat[1], cFloat[0] > float4(0.5f))"
expect-source pixel contains "dot((r[0]).xy, (cFloat[3]).xy) + (cFloat[4]).x"
probe (32, 32) rgba(0.5, 0.2, 0.26, 1.0) 2
