; oracle: D3D9 ps_2_0 TEXLDP divides texture coordinates by w before sampling; reduced from the STALKER CoP accum_sun_cascade shader family
; oracle-date: 2026-08-29

; c0 = (0.125, 0.5, 0.0, 0.25). TEXLDP samples x = 0.125 / 0.25 = 0.5,
; selecting the blue texel. Treating the instruction as ordinary TEX samples
; x = 0.125 and incorrectly selects red.
[pixel shader d3dbc-hex]
ffff0200
0200001f 90000000 a00f0800
05000051 a00f0000 3e000000 3f000000 00000000 3e800000
03010042 800f0000 a0e40000 a0e40800
02000001 800f0800 80e40000
0000ffff

[test]
expect-source pixel contains "/ float4("
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture 0 4 1 A8R8G8B8 red green blue white
dxmt9-sampler 0 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-bind-texture 0 0
dxmt9-draw-solid-quad
probe (32, 32) rgba(0.0, 0.0, 1.0, 1.0) 1
