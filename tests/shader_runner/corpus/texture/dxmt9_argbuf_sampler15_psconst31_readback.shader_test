[pixel shader d3dbc-hex]
ffff0200 0200001f 80000000 b0030000 0200001f 90000000 a00f080f
03000042 800f0000 b0e40000 a0e4080f 03000005 800f0000 80e40000
a0e4001f 02000001 800f0800 80e40000 0000ffff

[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture 0 1 1 A8R8G8B8 white
dxmt9-sampler 15 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-bind-texture 15 0
dxmt9-ps-const-f 31 0.125 0.375 0.750 1.0
dxmt9-draw-textured-quad
expect-source pixel contains "tex15.sample(samp15"
expect-source pixel contains "psConsts.psFloatConst[31]"
probe (32, 32) rgba(0.125, 0.375, 0.750, 1.0) 1
