[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture-raw 0 2 2 R32F cdcccc3dcdcc4c3e9a99993ecdcccc3e
dxmt9-sampler 0 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point lod_bias=GET4
dxmt9-bind-texture 0 0
dxmt9-draw-textured-quad
probe (16, 16) rgba(0.2, 0.3, 0.4, 0.1) 2
