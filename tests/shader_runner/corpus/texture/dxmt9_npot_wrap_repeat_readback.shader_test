[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture 0 3 2 A8R8G8B8 red green blue white black rgba(1.0,1.0,0.0,1.0)
dxmt9-sampler 0 address_u=wrap address_v=wrap min_filter=point mag_filter=point mip_filter=point
dxmt9-bind-texture 0 0
dxmt9-draw-textured-quad-overscan
probe (20, 20) rgba(1.0, 0.0, 0.0, 1.0) 1
probe (42, 20) rgba(0.0, 0.0, 1.0, 1.0) 1
probe (20, 8) rgba(1.0, 1.0, 1.0, 1.0) 1
probe (8, 8) rgba(1.0, 1.0, 0.0, 1.0) 1
