; oracle: Wine d3d9 visual.c test_texture_blending behavior, reduced to FFP alpha LERP
; oracle-date: 2026-05-18

[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-render-state z_enable=disable z_write=disable
dxmt9-texture 0 1 1 A8R8G8B8 rgba(0.25,0.25,0.25,0.25)
dxmt9-texture 1 1 1 A8R8G8B8 rgba(0.0,0.0,0.0,0.0)
dxmt9-sampler 0 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-sampler 1 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-texture-stage 0 color_op=selectarg1 alpha_op=selectarg1 color_arg1=texture alpha_arg1=texture texcoord_index=0
dxmt9-texture-stage 1 color_op=selectarg1 alpha_op=lerp color_arg1=texture alpha_arg1=texture alpha_arg2=diffuse texcoord_index=0
dxmt9-bind-texture 0 0
dxmt9-bind-texture 1 1
dxmt9-draw-textured-quad
probe (32, 32) rgba(0.0, 0.0, 0.0, 0.75) 2
