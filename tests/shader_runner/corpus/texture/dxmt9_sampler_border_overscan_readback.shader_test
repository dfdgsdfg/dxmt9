[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture 0 2 2 A8R8G8B8 red green blue white
dxmt9-sampler 0 address_u=border address_v=border min_filter=point mag_filter=point mip_filter=point
dxmt9-bind-texture 0 0
dxmt9-draw-textured-quad-overscan
probe (4, 4) rgba(0.0, 0.0, 0.0, 0.0) 1
probe (60, 4) rgba(0.0, 0.0, 0.0, 0.0) 1
probe (4, 60) rgba(0.0, 0.0, 0.0, 0.0) 1
probe (60, 60) rgba(0.0, 0.0, 0.0, 0.0) 1
