; oracle-date: 2026-05-18

[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture 0 1 1 A8R8G8B8 rgba(1.0,1.0,1.0,1.0)
dxmt9-bind-texture 0 0
dxmt9-sampler 0 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-render-state zenable=off zwrite=off
dxmt9-texture-stage 0 color_op=selectarg1 color_arg1=specular alpha_op=selectarg1 alpha_arg1=diffuse
dxmt9-draw-ffp-positiont-specular-quad
probe (32, 32) rgba(0.0, 0.0, 1.0, 1.0) 1
