[pixel shader d3dbc-hex]
ffff0200 05000051 a00f0000 00000000 3f800000 00000000 3e800000
02000001 800f0800 a0e40000 0000ffff

[test]
clear rgba(0.25, 0.0, 0.5, 1.0)
dxmt9-clear-depth 1.0
alpha-test enable notequal 0.5
dxmt9-render-state zenable=on zwrite=on zfunc=less color_write=green
dxmt9-draw-solid-quad-xyz-depth 0.25
probe (32, 32) rgba(0.25, 1.0, 0.5, 1.0) 2
