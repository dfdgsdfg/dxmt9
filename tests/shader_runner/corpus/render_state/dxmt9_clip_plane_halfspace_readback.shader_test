; [provenance]
; source: dxmt9
; source_kind: project-authored
; license: MIT
; license_scope: project-mit
; oracle: Wine d3d9 visual.c clip_planes_test — half-space discrimination
;         (FFP, plane (0, 1, 0, 0): keeps positive-y clip-space, clips
;         negative-y).
; oracle-date: 2026-05-23

; Passing as of the Apple-Metal single-`[[clip_distance]]` fix:
; Apple Metal (Apple7+) only honours one `[[clip_distance]]` output per
; vertex shader. The array form and multiple-scalar form both silently
; clip every fragment. dxmt9 now collapses D3D9's up-to-six clip planes
; into one slot via `min(d_i)` over the enabled mask, which is
; equivalent to "any plane discards" (any d_i < 0 ⇒ min < 0 ⇒ clip).
; The existing `dxmt9_clip_plane_runtime_readback.shader_test` keeps the
; degenerate all-clip case alive; this corpus pins the half-space
; discrimination case that the previous array/multi-scalar form could
; not honour.

[test]
clip-plane-mask 1
clear rgba(1.0, 0.0, 0.0, 1.0)
dxmt9-render-state zenable=off
dxmt9-texture 0 1 1 A8R8G8B8 rgba(1.0,1.0,1.0,1.0)
dxmt9-bind-texture 0 0
dxmt9-sampler 0 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-texture-stage 0 color_op=selectarg1 color_arg1=diffuse alpha_op=selectarg1 alpha_arg1=diffuse
dxmt9-clip-plane 0 0.0 1.0 0.0 0.0
dxmt9-render-state clip_planes=1
dxmt9-draw-ffp-color-vertex-quad
; Expected (Wine): upper half of NDC y survives → upper screen rows show
; green; lower half clipped → lower rows show clear red.
probe (32, 8) rgba(0.0, 1.0, 0.0, 1.0) 2
probe (32, 56) rgba(1.0, 0.0, 0.0, 1.0) 2
