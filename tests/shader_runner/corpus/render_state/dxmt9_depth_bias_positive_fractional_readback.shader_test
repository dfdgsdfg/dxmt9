; [provenance]
; source: dxmt9
; source_kind: project-authored
; license: MIT
; license_scope: project-mit
; oracle: D3D9 normalized positive DEPTHBIAS semantics, reduced from the 3DMark06 GT1 shadow-map value
; oracle-date: 2026-08-26
;
; A positive fractional D3D9 depth bias must push coplanar geometry beyond the
; cleared depth so GREATER accepts it. Directly forwarding 0.00045 to Metal
; quantizes it to zero on Depth32Float and leaves the clear color visible.

[pixel shader d3dbc-hex]
ffff0200 05000051 a00f0000 00000000 3f800000 00000000 3f800000
02000001 800f0800 a0e40000 0000ffff

[test]
clear rgba(1.0, 0.0, 0.0, 1.0)
dxmt9-clear-depth 0.5
dxmt9-render-state zenable=on zwrite=on zfunc=greater depth_bias=0.00045
dxmt9-draw-solid-quad-xyz-depth 0.5
probe (32, 32) rgba(0.0, 1.0, 0.0, 1.0) 2
