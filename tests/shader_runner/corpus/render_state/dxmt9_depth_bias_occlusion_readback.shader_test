; [provenance]
; source: dxmt9
; source_kind: project-authored
; license: MIT
; license_scope: project-mit
; oracle: Wine d3d9 visual.c test_depthbias behavior, reduced to constant DEPTHBIAS occluding a coplanar quad
; oracle-date: 2026-05-23
;
; Probe expects green (the biased draw passing the strict-less depth test against the
; cleared 0.5 depth). The depth_bias=-0.001 (as a float DWORD bit-pattern) should push
; the drawn z below the cleared 0.5 so that zfunc=less accepts it. Without depth-bias
; plumbing this fails: the strict-less test rejects 0.5 vs 0.5 and the cleared red shows.
;
; Status note: dxmt9_draw_encoder.mm currently hardcodes depth_bias/slope_scale/clamp
; to 0.0 in setRasterizerCullMode and the prologue setRasterizerState (lines ~554 and
; ~1149), so D3DRS_DEPTHBIAS / D3DRS_SLOPESCALEDEPTHBIAS never reach Metal. See the
; commit message for the documented backend gap.

[pixel shader d3dbc-hex]
ffff0200 05000051 a00f0000 00000000 3f800000 00000000 3f800000
02000001 800f0800 a0e40000 0000ffff

[test]
clear rgba(1.0, 0.0, 0.0, 1.0)
dxmt9-clear-depth 0.5
dxmt9-render-state zenable=on zwrite=on zfunc=less depth_bias=-0.001
dxmt9-draw-solid-quad-xyz-depth 0.5
probe (32, 32) rgba(0.0, 1.0, 0.0, 1.0) 2
