probe (48, 16) rgba(1.0, 1.0, 1.0, 1.0) 1
probe (16, 48) rgba(1.0, 1.0, 1.0, 1.0) 1
probe (48, 48) rgba(1.0, 1.0, 1.0, 1.0) 1
