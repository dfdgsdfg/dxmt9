[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-draw-textured-quad-tex2
expect-source pixel contains "outTexcoord[0] = float4(dot((outTexcoord[0]).xyz, (outTexcoord[1]).xyz));"
