[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-texture 0 1 1 A8R8G8B8 red
dxmt9-texture 1 2 2 A8R8G8B8 red green blue white
dxmt9-sampler 1 address_u=clamp address_v=clamp min_filter=point mag_filter=point mip_filter=point
dxmt9-bind-texture 1 1
dxmt9-draw-textured-quad-tex2
probe (16, 16) rgba(1.0, 1.0, 1.0, 1.0) 1
probe (48, 16) rgba(0.0, 0.0, 1.0, 1.0) 1
probe (16, 48) rgba(0.0, 1.0, 0.0, 1.0) 1
probe (48, 48) rgba(1.0, 0.0, 0.0, 1.0) 1
