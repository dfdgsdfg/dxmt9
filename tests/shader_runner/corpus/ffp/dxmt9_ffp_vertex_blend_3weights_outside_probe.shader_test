[test]
clear rgba(0.0, 0.0, 0.0, 1.0)
dxmt9-render-state zenable=off zwrite=off
dxmt9-draw-ffp-vertex-blend-3weights-triangle
probe (48, 32) rgba(0.0, 1.0, 0.0, 1.0) 1
probe (8, 32) rgba(0.0, 0.0, 0.0, 1.0) 1
probe (32, 8) rgba(0.0, 0.0, 0.0, 1.0) 1
