; Import definition for libdxmt9.dylib (installed as dxmt9.dll in the Wine prefix).
; Used by dlltool to generate the import stub library:
;   aarch64-w64-mingw32-dlltool -m arm64 -d dxmt9_imports.def -l libdxmt9.dll.a
